#include <stdio.h>
#include <stdint.h>
#include "driver/i2c_master.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#define SDA_PIN 9
#define SCL_PIN 10
#define BME_ADDR 0x76

static i2c_master_dev_handle_t dev;

// 보정 계수 (센서 안에 저장된 공장 보정값)
static uint16_t T1, P1; static int16_t T2, T3;
static int16_t P2, P3, P4, P5, P6, P7, P8, P9;
static uint8_t H1, H3; static int16_t H2, H4, H5; static int8_t H6;

// 레지스터 1바이트 쓰기
static void reg_write(uint8_t reg, uint8_t val)
{
    uint8_t buf[2] = {reg, val};
    i2c_master_transmit(dev, buf, 2, 100);
}

// 레지스터 여러 바이트 읽기
static void reg_read(uint8_t reg, uint8_t *data, size_t len)
{
    i2c_master_transmit_receive(dev, &reg, 1, data, len, 100);
}

static void read_calibration(void)
{
    uint8_t c[26], e[7];
    reg_read(0x88, c, 26);
    reg_read(0xE1, e, 7);
    T1 = c[0] | (c[1] << 8);  T2 = c[2] | (c[3] << 8);  T3 = c[4] | (c[5] << 8);
    P1 = c[6] | (c[7] << 8);  P2 = c[8] | (c[9] << 8);  P3 = c[10] | (c[11] << 8);
    P4 = c[12] | (c[13] << 8); P5 = c[14] | (c[15] << 8); P6 = c[16] | (c[17] << 8);
    P7 = c[18] | (c[19] << 8); P8 = c[20] | (c[21] << 8); P9 = c[22] | (c[23] << 8);
    H1 = c[25];
    H2 = e[0] | (e[1] << 8);
    H3 = e[2];
    H4 = ((int8_t)e[3] << 4) | (e[4] & 0x0F);
    H5 = ((int8_t)e[5] << 4) | (e[4] >> 4);
    H6 = (int8_t)e[6];
}

void app_main(void)
{
    // 1) I2C 버스 켜기
    i2c_master_bus_config_t bus_cfg = {
        .i2c_port = I2C_NUM_0,
        .sda_io_num = SDA_PIN,
        .scl_io_num = SCL_PIN,
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true,
    };
    i2c_master_bus_handle_t bus;
    i2c_new_master_bus(&bus_cfg, &bus);

    // 2) 센서(0x76)를 버스에 등록
    i2c_device_config_t dev_cfg = {
        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
        .device_address = BME_ADDR,
        .scl_speed_hz = 100000,
    };
    i2c_master_bus_add_device(bus, &dev_cfg, &dev);

    // 3) 칩 ID 확인: 0x60 = BME280, 0x58 = BMP280(습도 없음)
    uint8_t id;
    reg_read(0xD0, &id, 1);
    printf("칩 ID: 0x%02X\n", id);

    // 4) 리셋 후 보정값 읽기, 측정 시작
    reg_write(0xE0, 0xB6);
    vTaskDelay(pdMS_TO_TICKS(10));
    read_calibration();
    reg_write(0xF2, 0x01);  // 습도 측정 켜기 (반드시 0xF4보다 먼저)
    reg_write(0xF4, 0x27);  // 온도/기압 측정 켜기 + 연속 측정 모드

    while (1) {
        // 5) 측정값 8바이트 읽기: 기압3 + 온도3 + 습도2
        uint8_t d[8];
        reg_read(0xF7, d, 8);
        int32_t adc_P = ((int32_t)d[0] << 12) | (d[1] << 4) | (d[2] >> 4);
        int32_t adc_T = ((int32_t)d[3] << 12) | (d[4] << 4) | (d[5] >> 4);
        int32_t adc_H = (d[6] << 8) | d[7];

        // 6) 보정 계산 (데이터시트 공식)
        double v1 = (adc_T / 16384.0 - T1 / 1024.0) * T2;
        double v2 = (adc_T / 131072.0 - T1 / 8192.0);
        v2 = v2 * v2 * T3;
        double t_fine = v1 + v2;
        double temp = t_fine / 5120.0;

        v1 = t_fine / 2.0 - 64000.0;
        v2 = v1 * v1 * P6 / 32768.0;
        v2 = v2 + v1 * P5 * 2.0;
        v2 = v2 / 4.0 + P4 * 65536.0;
        v1 = (P3 * v1 * v1 / 524288.0 + P2 * v1) / 524288.0;
        v1 = (1.0 + v1 / 32768.0) * P1;
        double press = 0;
        if (v1 != 0) {
            press = 1048576.0 - adc_P;
            press = (press - v2 / 4096.0) * 6250.0 / v1;
            v1 = P9 * press * press / 2147483648.0;
            v2 = press * P8 / 32768.0;
            press = press + (v1 + v2 + P7) / 16.0;
        }

        double h = t_fine - 76800.0;
        h = (adc_H - (H4 * 64.0 + H5 / 16384.0 * h)) *
            (H2 / 65536.0 * (1.0 + H6 / 67108864.0 * h * (1.0 + H3 / 67108864.0 * h)));
        h = h * (1.0 - H1 * h / 524288.0);
        if (h > 100.0) h = 100.0;
        if (h < 0.0) h = 0.0;

        printf("온도: %.2f C | 습도: %.2f %% | 기압: %.2f hPa\n", temp, h, press / 100.0);
        vTaskDelay(pdMS_TO_TICKS(2000));
    }
}